# VoiceLock Gateway — Environment Configuration Template
# Copy this file to .env (or backend/.env) and fill in real values locally.
# NEVER commit .env or expose secrets to frontend Vite variables.

APP_ENV=development
APP_SECRET_KEY=replace-with-cryptographically-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL connection (asyncpg or psycopg3/psycopg2)
DATABASE_URL=postgresql+psycopg://voicelock:voicelock@localhost:5432/voicelock

# Detectif.ai Platform API (Backend-only)
# Obtain from https://platform.detectif.ai -> API keys
DETECTIF_API_KEY=
DETECTIF_BASE_URL=https://platform.detectif.ai
DETECTIF_TIMEOUT_SECONDS=60
DETECTIF_MAX_RETRIES=2

# Feature toggles & provider mode
# live: requires DETECTIF_API_KEY; mock: uses clearly labelled development mock adapter; auto: uses live if DETECTIF_API_KEY is set, otherwise mock
DETECTIF_PROVIDER_MODE=auto
ALETHEIA_ENABLED=true
EIDOS_ENABLED=true

# Speech transcription (faster-whisper)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio upload & temporary processing constraints
MAX_AUDIO_SIZE_MB=25
TEMP_AUDIO_DIR=./tmp_audio
ENROLLMENT_MIN_DURATION_SECONDS=15
ENROLLMENT_MAX_DURATION_SECONDS=60
VERIFICATION_MIN_DURATION_SECONDS=3
VERIFICATION_MAX_DURATION_SECONDS=60
CHALLENGE_TTL_SECONDS=180
DECISION_TOKEN_TTL_SECONDS=180

# CORS & Frontend Origin
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# n8n Security Automation Engine (Backend-only; never expose secrets to frontend)
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voicesuraksha-events
N8N_WEBHOOK_SECRET=replace-with-random-hmac-webhook-secret
N8N_TIMEOUT_SECONDS=8
N8N_MAX_RETRIES=3
N8N_REPORTING_API_KEY=replace-with-random-reporting-api-key
